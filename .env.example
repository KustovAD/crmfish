# Ключи Supabase нужны ТОЛЬКО на Vercel (Settings → Environment Variables).
# На своём компьютере их не задавайте — тогда CRMFish работает со встроенной базой data/crmfish.json.
# (Если всё же создать .env.local с этими строками, локальный запуск тоже пойдёт в Supabase.)
#
# Где взять: Supabase → кнопка Connect вверху дашборда (или Project Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Пароль на сайт — тоже только в Vercel:
# APP_PASSWORD=ваш_пароль
