# Скопируйте этот файл в .env.local и вставьте данные из Supabase:
# кнопка Connect вверху дашборда (или Project Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Пароль на сайт задаётся ТОЛЬКО в Vercel → Settings → Environment Variables:
# APP_PASSWORD=ваш_пароль
# (локально через npm run dev пароль не запрашивается)
